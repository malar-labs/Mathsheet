# Primary provider. Get a FREE Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your FREE Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your FREE OpenRouter API key at: https://openrouter.ai/keys
# Used as fallback when Groq hits rate limits
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: change the secret key for sessions
SECRET_KEY=mathsheet-bc-grade8-secret-change-me

# ===== Supabase (learner accounts + saved progress) =====
# Optional. Leave both blank and the app still works — progress just stays in
# the browser instead of following a learner to another device.
# Run supabase_schema.sql in the SQL Editor once, then fill these in.
SUPABASE_URL=https://your-project.supabase.co
# The "service_role" / secret key, NOT the publishable one. Server-side only.
SUPABASE_SECRET_KEY=

# ===== Cloudflare Web Analytics (optional) =====
# The live site's token is built in, so you only set this to override it --
# set it to nothing at all to turn tracking off (e.g. when running locally).
CF_ANALYTICS_TOKEN=
